#!/bin/sh
# dbus mock：koolshare 的 skipd 键值库，只实现插件用到的子命令
# 数据落在 /tmp/mock-dbus.txt（key=value）
DB="${MOCK_DBUS_FILE:-/tmp/mock-dbus.txt}"
[ -f "$DB" ] || : >"$DB"

# BusyBox sed 与 BSD sed 的 -i 语法不兼容，统一走临时文件
sed_inplace() {
    sed "$1" "$2" >"$2.sedtmp" 2>/dev/null && mv "$2.sedtmp" "$2" || rm -f "$2.sedtmp"
}

case "$1" in
    get)
        key="$2"
        sed -n "s/^${key}=//p" "$DB" 2>/dev/null | head -n 1
        ;;
    set)
        kv="$2"
        key="${kv%%=*}"
        val="${kv#*=}"
        # 真机的 dbus 是「原样存字符串」：值里的反斜杠就是反斜杠（httpdb 传下来
        # 的字面 \n 会原样躺在库里）。而 sed 的替换串里 `\n` 会被解释成换行、
        # `&` 会展开成整个匹配 —— 不转义的话 mock 会把值改掉，测试就测不到真机
        # 形态（真机上用户输入两行 = dbus 里的字面 \n，正是那条垃圾域名的来源）。
        val_esc=$(printf '%s' "$val" | sed 's/\\/\\\\/g; s/&/\\&/g')
        if grep -q "^${key}=" "$DB" 2>/dev/null; then
            sed_inplace "s|^${key}=.*|${key}=${val_esc}|" "$DB"
        else
            echo "${key}=${val}" >>"$DB"
        fi
        ;;
    remove)
        sed_inplace "/^$2=/d" "$DB"
        ;;
    list)
        if [ -n "$2" ]; then
            grep "^$2" "$DB" 2>/dev/null
        else
            cat "$DB"
        fi
        ;;
    *) echo "mock dbus: unsupported: $*" >&2 ;;
esac
exit 0
